# Copy to .env and adjust. Never commit the real .env file.

APP_NAME="FastAPI Starter Kit"
ENVIRONMENT=local
DEBUG=true

# SQLite by default (zero setup). Swap for Postgres in staging/prod, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/app_db
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-every-environment
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

BACKEND_CORS_ORIGINS=["http://localhost:3000"]
